{
  "name": "robokit",
  "version": "1.0.0",
  "private": true,
  "description": "Robokit",
  "author": "scalecube.io <scalecube.io@gmail.com>",
  "license": "ISC",
  "repository": "https://github.com/scalecube/robokit.git",
  "homepage": "https://github.com/scalecube/robolit",
  "bugs": "https://github.com/scalecube/robokit/issues",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "dev": "./node_modules/.bin/nodemon",
    "robokit": "node ./src/server.js",
    "start": "./node_modules/.bin/probot run ./src/webhook.js",
    "lint": "./node_modules/.bin/standard --fix",
    "test": "jest --testPathPattern=test/unit",
    "test:e2e": "jest --testPathPattern=test/e2e"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "pino": "^9.14.0",
    "probot": "^13.4.5",
    "rxjs": "^6.6.7",
    "websocket": "^1.0.34"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^11.4.0",
    "nodemon": "^2.0.0",
    "smee-client": "^5.0.0",
    "standard": "^17.1.2"
  },
  "engines": {
    "node": ">= 18"
  },
  "standard": {
    "env": [
      "jest"
    ]
  },
  "nodemonConfig": {
    "exec": "npm start",
    "watch": [
      ".env",
      "."
    ]
  },
  "jest": {
    "testEnvironment": "node"
  }
}
